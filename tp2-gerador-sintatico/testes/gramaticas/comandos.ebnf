(* Comandos com if/else, while e blocos.
   Valida, mas deve emitir AVISO de else pendente em [ "else" comando ]. *)
TOKENS
NUM = /[0-9]+/ ;
ID = /[a-zA-Z_][a-zA-Z0-9_]*/ ;
SKIP = /[ \t\r\n]+/ ;
RULES
programa = { comando } ;
comando = "if" "(" expr ")" comando [ "else" comando ]
        | "while" "(" expr ")" comando
        | "{" { comando } "}"
        | ID "=" expr ";" ;
expr = termo { ( "+" | "-" | "<" ) termo } ;
termo = NUM | ID | "(" expr ")" ;
